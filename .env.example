# ---------------------------------------------------------------------------
# Production configuration. Copy to `.env` and fill in every value.
# `.env` is gitignored; never commit real secrets.
#
# Generate the two JWT secrets with:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------

# --- domains ---------------------------------------------------------------
# Both must already point at this server's IP before `docker compose up`,
# or certificate issuance will fail.
PORTAL_DOMAIN=portal.kodesportsclub.com
ADMIN_DOMAIN=cms.kodesportsclub.com
ACME_EMAIL=it@kodesportsclub.com
# Where TLS certificates come from. Leave blank for public Let's Encrypt
# certificates, which need ports 80 and 443 reachable from the internet.
# Set to `internal` for a VM on the company network with no inbound path:
# Caddy then issues from its own CA, and you trust that root once per device.
# See docs/DEPLOY-INTERNAL.md.
TLS_MODE=

# Who may reach the CMS at all, as space-separated CIDR ranges. Requests from
# anywhere else get a 403 from the proxy before they see a login form.
# Strongly recommended on a public deployment: the portal has to answer the
# internet, the CMS does not.
#   e.g. ADMIN_ALLOWED_IPS=203.0.113.4/32 10.0.0.0/8
# Leave blank to allow any address.
ADMIN_ALLOWED_IPS=

# --- database --------------------------------------------------------------
POSTGRES_USER=kode
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=kode_portal
# Keep (replicas x DATABASE_POOL_SIZE) below Postgres max_connections.
DATABASE_POOL_SIZE=10

# --- session ---------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_openssl_rand_base64_48
JWT_REFRESH_SECRET=change_me_a_different_openssl_rand_base64_48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Set only when portal and CMS are subdomains of one parent and you want a
# shared cookie, e.g. .kodesportsclub.com. Leave blank for host-only cookies.
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# --- Microsoft Entra ID (optional) -----------------------------------------
# Leave ENTRA_ENABLED=false to run entirely on local accounts.
# Register an app in Azure, add a client secret, and set the redirect URI to:
#   https://<PORTAL_DOMAIN>/api/v1/auth/entra/callback
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
# Comma-separated. Empty means any user in the tenant may sign in.
ENTRA_ALLOWED_DOMAINS=kodesportsclub.com
# false means an Entra user with no portal account is rejected rather than created.
ENTRA_AUTO_PROVISION=true

# --- email -----------------------------------------------------------------
# Leave SMTP_HOST blank to log outbound mail instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=KODE Portal <no-reply@kodesportsclub.com>
# The inbox that turns an email into an Odoo ticket.
IT_SUPPORT_INBOX=it-support@kodesportsclub.com

# --- operations ------------------------------------------------------------
LOG_LEVEL=info
ENABLE_SWAGGER=false
BACKUP_RETENTION_DAYS=14

# --- first-run seed passwords ----------------------------------------------
# Used once by `make seed`. Remove them from .env afterwards.
SEED_SUPER_ADMIN_PASSWORD=
SEED_CONTENT_MANAGER_PASSWORD=
SEED_CONTENT_EDITOR_PASSWORD=
SEED_DEPARTMENT_EDITOR_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
