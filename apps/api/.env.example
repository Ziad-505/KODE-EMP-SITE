# Local development for the API when running it outside Docker.
# Copy to apps/api/.env
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
PORTAL_PUBLIC_URL=http://localhost:5173
ADMIN_PUBLIC_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 55432 is the host port docker-compose.dev.yml publishes; see the note there.
DATABASE_URL=postgresql://kode:kode_dev_password@localhost:55432/kode_portal?schema=public

JWT_ACCESS_SECRET=dev_access_secret_not_for_production_0123456789
JWT_REFRESH_SECRET=dev_refresh_secret_not_for_production_9876543210

UPLOAD_DIR=./storage/uploads
LOG_LEVEL=debug

# Mailpit, started by docker-compose.dev.yml. Inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

ENTRA_ENABLED=false
