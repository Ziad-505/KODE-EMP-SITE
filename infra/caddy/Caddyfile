{
	email {$ACME_EMAIL}
	# Certificates are obtained and renewed automatically over HTTP-01/TLS-ALPN.
}

# TLS_MODE decides where certificates come from, because the answer differs for
# an internal deployment and a public one, and getting it wrong is the single
# most common way this stack fails to come up.
#
#   <an email address>  Public ACME. Requires that Let's Encrypt can reach
#                       ports 80 and 443 on this host from the internet.
#                       Defaults to ACME_EMAIL, which is the public behaviour.
#   internal            Caddy's own local CA. Correct for a VM on the company
#                       network with no inbound path from the internet: ACME
#                       cannot validate a host it cannot reach, so the stack
#                       would otherwise sit retrying and serve nothing.
#                       Browsers then need the Caddy root trusted once — the
#                       procedure is in docs/DEPLOY-INTERNAL.md.
(tls_mode) {
	tls {$TLS_MODE}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
}

# ------------------------------------------------------------ employee portal
{$PORTAL_DOMAIN} {
	import tls_mode
	import security_headers
	encode zstd gzip

	# The API is served from the same origin as the SPA, which is what lets the
	# session cookie stay SameSite=Lax rather than needing SameSite=None.
	handle /api/* {
		reverse_proxy api:4000
	}

	handle /media/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy portal:80
	}
}

# ---------------------------------------------------------------------- CMS
{$ADMIN_DOMAIN} {
	import tls_mode
	import security_headers
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:4000
	}

	handle /media/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy admin:80
	}
}
